PORT=5000
NODE_ENV=development

# Database Connection
# For PostgreSQL: postgresql://postgres:postgrespassword@localhost:5432/ai_travel_companion?schema=public
# For zero-config SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_travel_companion_dev_2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# AI & LLM Providers
OPENAI_API_KEY=
LANGSMITH_API_KEY=
LANGCHAIN_TRACING_V2=false

# Travel Inventory Providers (Leave blank to use verified Sandbox Mock Engine)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
DUFFEL_ACCESS_TOKEN=

# Payments (Test Mode)
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
